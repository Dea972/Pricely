{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "pricely-api"
  },
  "Catalog": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "Users": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "Pricing": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Collection": {
      "Enabled": false,
      "IntervalInMinutes": 1440
    }
  },
  "Agentic": {
    "DefaultApprovalScope": "pricely.write",
    "AccessPolicy": "pricely.read",
    "MaximumToolRoundTrips": 10,
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "AiEngine": {
    "Prices": {
      "LiteLlmPriceList": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
      "PricingPages": {
        "Anthropic": "https://platform.claude.com/docs/en/about-claude/pricing"
      }
    },
    "WebSearch": {
      "PricePerSearch": {
        "Anthropic": 0.01
      }
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 50
    }
  },
  "Ai": {
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5-5",
      "MaxTokens": 4096,
      "TimeoutInSeconds": 120
    }
  },
  "WebSearch": {
    "Provider": "Anthropic",
    "MaxSearchesPerDay": 200,
    "MaxSearchesPerRequest": 2,
    "Brave": {
      "BaseAddress": "https://api.search.brave.com/"
    }
  }
}
