{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "Pricing": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Collection": {
      "Enabled": false,
      "IntervalInMinutes": 1440
    }
  }
}
