{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "pricely-api"
  },
  "Catalog": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "Users": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "Pricing": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Collection": {
      "Enabled": false,
      "IntervalInMinutes": 1440
    }
  },
  "Agentic": {
    "DefaultApprovalScope": "pricely.write",
    "MaximumToolRoundTrips": 10,
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  },
  "AiEngine": {
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 50
    }
  },
  "Ai": {
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5-5",
      "MaxTokens": 4096,
      "TimeoutInSeconds": 120
    }
  }
}
