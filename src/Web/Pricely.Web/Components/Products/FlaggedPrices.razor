@inject TimeProvider Clock

<section class="card grow-1" aria-labelledby="h-anomalies">
    <div class="card-body" style="display: flex; flex-direction: column; gap: 12px">
        <h2 id="h-anomalies">Prix signalés</h2>
        @if (!Flagged.Any())
        {
            <p class="muted" style="margin: 0">Aucun prix signalé sur les derniers relevés.</p>
        }
        @foreach (ProductOfferDto offer in Flagged)
        {
            <div class="flag">
                <div><strong>@offer.MerchantName — @Format.Price(offer.LatestAmount, offer.LatestCurrency)</strong></div>
                <div class="small muted">
                    Relevé @(offer.LatestObservedOnUtc is DateTime observed ? Format.Ago(observed, Clock.GetUtcNow()) : "—")
                    · médiane des offres confirmées @Format.Price(Offers.ConfirmedMedianAmount, Offers.Currency)
                </div>
                <div style="margin-top: 10px">
                    <ExternalLink Address="@offer.ProductPage" Class="btn btn-secondary btn-small" TextOnlyWhenValid="true">Voir la page</ExternalLink>
                </div>
            </div>
        }
        <p class="small muted" style="margin: 0">Un relevé trop éloigné de la médiane des autres offres confirmées est signalé, jamais supprimé.</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public ProductOffersDto Offers { get; set; } = default!;

    private IEnumerable<ProductOfferDto> Flagged => Offers.Offers.Where(o => o.LatestIsFlaggedAsAnomaly);
}
