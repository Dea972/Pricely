@implements IDisposable
@inject NavigationManager Navigation
@inject ReviewQueue Reviews

<nav id="main-nav" class="sidebar @(Open ? "open" : null)" aria-label="Navigation principale">
    <div class="sidebar-logo"><Logo /></div>

    <a href="/" class="nav-item" aria-current="@Current(IsAssistant)" @onclick="OnNavigate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        Assistant
    </a>
    <a href="/products" class="nav-item" aria-current="@Current(IsProducts)" @onclick="OnNavigate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8l-9-5-9 5v8l9 5z"></path><path d="M3.3 7 12 12l8.7-5M12 22V12"></path></svg>
        Produits
    </a>
    <a href="/review" class="nav-item" aria-current="@Current(IsReview)" @onclick="OnNavigate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 11l3 3 8-8"></path><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"></path></svg>
        Offres à valider
        @if (Reviews.Count > 0)
        {
            <span class="badge badge-count nav-badge"><span class="visually-hidden">en attente : </span>@Reviews.Count</span>
        }
    </a>
    <a href="/profiles" class="nav-item" aria-current="@Current(IsProfiles)" @onclick="OnNavigate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h6"></path></svg>
        Profils de collecte
    </a>
    <a href="/ai" class="nav-item" aria-current="@Current(IsAi)" @onclick="OnNavigate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
        IA et coûts
    </a>

    <div class="sidebar-spacer"></div>

    <AuthorizeView>
        <div class="user">
            <span class="avatar" aria-hidden="true">@Format.Initials(DisplayName(context.User))</span>
            <span class="user-name">@DisplayName(context.User)</span>
        </div>
        <form method="post" action="authentication/logout" class="logout">
            <AntiforgeryToken />
            <button type="submit" class="nav-item nav-button">Se déconnecter</button>
        </form>
    </AuthorizeView>
</nav>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    // The site is served at the root.
    private string Path => new Uri(Navigation.Uri).AbsolutePath;

    private bool IsAssistant => Path == "/" || Path.StartsWith("/assistant", StringComparison.Ordinal);

    private bool IsProducts => Path.StartsWith("/products", StringComparison.Ordinal);

    private bool IsReview => Path.StartsWith("/review", StringComparison.Ordinal);

    private bool IsProfiles => Path.StartsWith("/profiles", StringComparison.Ordinal);

    private bool IsAi => Path.StartsWith("/ai", StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Reviews.Changed += OnReviewsChanged;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Reviews.Changed -= OnReviewsChanged;
    }

    private void OnReviewsChanged() => InvokeAsync(StateHasChanged);

    private static string? Current(bool active) => active ? "page" : null;

    private static string DisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.Identity?.Name ?? user.FindFirst(Pricely.Web.Authentication.PricelyClaims.PreferredUserName)?.Value ?? "Utilisateur";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
}
