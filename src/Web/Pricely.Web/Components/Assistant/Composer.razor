<form class="composer" @onsubmit="SubmitAsync">
    <div class="composer-inner">
        @if (Suggestions.Count > 0)
        {
            <div class="suggestions">
                @foreach (string suggestion in Suggestions)
                {
                    <button type="button" class="suggestion" disabled="@Disabled" @onclick="() => SendAsync(suggestion)">@suggestion</button>
                }
            </div>
        }
        <div class="prompt-box">
            <label for="prompt" class="visually-hidden">Message à l'assistant</label>
            <textarea id="prompt" rows="2" maxlength="8000" data-submit-on-enter
                      placeholder="Demande un comparatif, un historique, une collecte…"
                      @bind="_draft" @bind:event="oninput"></textarea>
            <button type="submit" class="send" aria-label="Envoyer" disabled="@(Disabled || string.IsNullOrWhiteSpace(_draft))">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </button>
        </div>
    </div>
</form>

@code {
    private string _draft = string.Empty;
    private string? _appliedPrefill;

    /// <summary>A message to put in the box (from the product page), the user sends it or not.</summary>
    [Parameter]
    public string? Prefill { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    protected override void OnParametersSet()
    {
        if (Prefill is not null && !string.Equals(Prefill, _appliedPrefill, StringComparison.Ordinal))
        {
            _appliedPrefill = Prefill;
            _draft = Prefill;
        }
    }

    private Task SubmitAsync() => SendAsync(_draft);

    private async Task SendAsync(string message)
    {
        if (Disabled || string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        _draft = string.Empty;
        await OnSend.InvokeAsync(message.Trim());
    }
}
