<div class="card">
    <div class="card-header">
        <div class="eyebrow">Historique des prix</div>
        @if (ProductId is Guid id)
        {
            <a class="btn btn-secondary btn-small" href="/products/@id">Ouvrir la fiche</a>
        }
    </div>
    <div class="card-body">
        <PriceChart Entries="Entries" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PriceHistoryEntryDto> Entries { get; set; } = [];

    [Parameter]
    public Guid? ProductId { get; set; }
}
