@if (Problem is not null)
{
    <div class="alert alert-warn" role="alert">
        @Problem.Message
        @if (Problem.IsSessionExpired)
        {
            <text> </text><a href="@Problem.LoginAddress" data-enhance-nav="false">Se reconnecter</a>
        }
    </div>
}

@code {
    [Parameter]
    public ApiProblem? Problem { get; set; }
}
